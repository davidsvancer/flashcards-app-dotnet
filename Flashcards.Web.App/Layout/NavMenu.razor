<div class="bg-gray-800 text-white p-3">
    <div class="container mx-auto flex justify-between items-center">
        <a class="text-xl font-bold" href="/">Flashcards.Web.App</a>
        <button type="button" title="Navigation menu" class="text-white focus:outline-none" @onclick="ToggleNavMenu" aria-expanded="@(collapseNavMenu ? "false" : "true")">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>
</div>

<div class="bg-gray-700 text-white" @onclick="ToggleNavMenu">
    <nav class="flex flex-col space-y-2 p-3 @(collapseNavMenu ? "hidden" : "")">

        <div @onclick="ToggleNavMenu" @onclick:stopPropagation="true">
            <NavLink class="block py-2 px-4 rounded hover:bg-gray-600" href="/" Match="NavLinkMatch.All">
                <span class="mr-2">🏠</span> Home
            </NavLink>
        </div>

        <div @onclick="ToggleNavMenu" @onclick:stopPropagation="true">
            <NavLink class="block py-2 px-4 rounded hover:bg-gray-600" href="cards">
                <span class="mr-2">♣️</span> Cards
            </NavLink>
        </div>

        <div @onclick="ToggleNavMenu" @onclick:stopPropagation="true">
            <NavLink class="block py-2 px-4 rounded hover:bg-gray-600" href="collections">
                <span class="mr-2">📚</span> Card Collections
            </NavLink>
        </div>

        <div @onclick="ToggleNavMenu" @onclick:stopPropagation="true">
            <NavLink class="block py-2 px-4 rounded hover:bg-gray-600" href="statistics">
                <span class="mr-2">📈</span> Statistics
            </NavLink>
        </div>

        <div class="nav-item" @onclick="ToggleNavMenu" @onclick:stopPropagation="true">
            <NavLink class="block py-2 px-4 rounded hover:bg-gray-600" href="users">
                <span class="mr-2">👤</span> Users
            </NavLink>
        </div>
        
        <div class="nav-item px-3" @onclick="ToggleNavMenu" @onclick:stopPropagation="true">
            <LoginDisplay />
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}