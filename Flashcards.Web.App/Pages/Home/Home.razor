@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="min-h-screen bg-gray-50">

    <AuthorizeView>
        <Authorized>
            <div class="container mx-auto px-4 py-12 max-w-6xl">

                <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl shadow-lg p-8 mb-10 text-white">
                    <h1 class="text-4xl font-bold mb-4">Welcome back! 👋</h1>
                    <p class="text-indigo-100 text-lg max-w-2xl">
                        Ready to exercise your brain? Pick a collection and start your daily streak, or check how much you've improved.
                    </p>
                    <div class="mt-8 flex gap-4">
                        <a href="collections" class="bg-white text-indigo-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition shadow-sm">
                            Start Studying
                        </a>
                        <a href="statistics" class="bg-indigo-700 bg-opacity-50 text-white px-6 py-3 rounded-lg font-semibold hover:bg-opacity-75 transition">
                            View Progress
                        </a>
                    </div>
                </div>

                <h2 class="text-2xl font-bold text-gray-800 mb-6">Quick Actions</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">

                    <a href="collections" class="block group">
                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all hover:-translate-y-1">
                            <div class="h-12 w-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                                📚
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Browse Collections</h3>
                            <p class="text-gray-500 text-sm">Explore your decks or public collections and start a new lesson.</p>
                        </div>
                    </a>

                    <a href="statistics" class="block group">
                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all hover:-translate-y-1">
                            <div class="h-12 w-12 bg-green-100 text-green-600 rounded-lg flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                                📊
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Check Statistics</h3>
                            <p class="text-gray-500 text-sm">See your accuracy, total cards reviewed, and study history.</p>
                        </div>
                    </a>

                    <a href="collections" class="block group">
                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all hover:-translate-y-1">
                            <div class="h-12 w-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
                                ➕
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Create New Deck</h3>
                            <p class="text-gray-500 text-sm">Have something new to memorize? Create a custom flashcard deck.</p>
                        </div>
                    </a>
                </div>

            </div>
        </Authorized>

        <NotAuthorized>
            <div class="bg-white pb-16 pt-24 lg:pb-32 lg:pt-32 border-b border-gray-100">
                <div class="container mx-auto px-4 text-center">
                    <h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-6">
                        Master any subject <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">
                            one card at a time.
                        </span>
                    </h1>
                    <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-10">
                        Flashcards App helps you remember things faster. Create your own decks, track your progress, and ace your exams.
                    </p>
                    <div class="flex justify-center gap-4">
                        <a href="authentication/login" class="bg-white text-gray-700 border border-gray-200 px-8 py-4 rounded-lg font-bold text-lg hover:bg-gray-50 transition">
                            Log In
                        </a>
                    </div>
                </div>
            </div>

            <div class="py-20 bg-gray-50">
                <div class="container mx-auto px-4 max-w-6xl">
                    <div class="text-center mb-16">
                        <h2 class="text-3xl font-bold text-gray-900">Everything you need to study</h2>
                        <p class="text-gray-500 mt-2">Simple, powerful, and effective.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                        <div class="text-center">
                            <div class="h-16 w-16 bg-white rounded-2xl shadow-sm flex items-center justify-center text-3xl mx-auto mb-6 text-indigo-600">
                                🧠
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Spaced Repetition</h3>
                            <p class="text-gray-500">We help you review cards at the perfect time so you never forget them.</p>
                        </div>

                        <div class="text-center">
                            <div class="h-16 w-16 bg-white rounded-2xl shadow-sm flex items-center justify-center text-3xl mx-auto mb-6 text-indigo-600">
                                📈
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Detailed Analytics</h3>
                            <p class="text-gray-500">Track your accuracy and see exactly where you need to improve.</p>
                        </div>

                        <div class="text-center">
                            <div class="h-16 w-16 bg-white rounded-2xl shadow-sm flex items-center justify-center text-3xl mx-auto mb-6 text-indigo-600">
                                🌍
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Anywhere Access</h3>
                            <p class="text-gray-500">Study on your phone, tablet, or computer. Your progress is always synced.</p>
                        </div>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>

</div>

@code {
}