@page "/collections/edit/{Id:guid}"
@layout EditLayout
@inherits PageBase
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="w-full min-h-screen flex justify-center py-12 px-6 bg-slate-50">

    @if (NewCard == null || CardCollection == null)
    {
        <div class="flex flex-col items-center gap-4">
            <div class="loader ease-linear rounded-full border-8 border-t-8 border-slate-200 h-16 w-16"></div>
            <p class="text-slate-500">Loading collection...</p>
        </div>
    }
    else
    {
        <div class="w-full max-w-[1100px] flex flex-col gap-8">

            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
                        <span class="p-2 bg-indigo-100 rounded-lg text-indigo-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                            </svg>
                        </span>
                        Edit Collection
                    </h1>
                    <p class="text-slate-500 mt-1 ml-14">Update details and manage cards.</p>
                </div>

                <button class="px-6 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all flex items-center gap-2"
                        @onclick="@SaveCollection">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    Save Changes
                </button>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
                <h2 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2 border-b border-slate-100 pb-2">
                    General Settings
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="md:col-span-2 space-y-2">
                        <label class="block text-sm font-bold text-slate-700 uppercase tracking-wider">Title</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 4.5l7.5 7.5-7.5 7.5m-6-15l7.5 7.5-7.5 7.5" />
                                </svg>
                            </div>
                            <input class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-slate-800 font-medium"
                                   placeholder="e.g. History of Rome"
                                   @bind="CardCollection.Title" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 uppercase tracking-wider">Answer Start</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                                </svg>
                            </div>
                            <input type="datetime-local"
                                   class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition text-slate-700 font-sans"
                                   @bind="CardCollection.AnswerStart" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-slate-700 uppercase tracking-wider">Answer End</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <input type="datetime-local"
                                   class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition text-slate-700 font-sans"
                                   @bind="CardCollection.AnswerEnd" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-4">
                <div class="flex justify-between items-end border-b border-slate-200 pb-2 mb-2">
                    <h2 class="text-xl font-bold text-slate-800">
                        Existing Cards
                        <span class="ml-2 text-sm font-normal text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">@CardCollection.Cards.Count items</span>
                    </h2>
                </div>

                <div class="flex flex-col gap-4">
                    @if (CardCollection.Cards.Any())
                    {
                        @foreach (var card in CardCollection.Cards)
                        {
                            <div class="bg-white p-4 border border-slate-200 rounded-xl shadow-sm hover:border-indigo-300 transition">
                                <CardForm Card="card" OnRemove="@((c) => DeleteCard(c))" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-8 text-slate-400 italic bg-white rounded-xl border border-dashed border-slate-300">
                            No cards in this collection yet. Add one below.
                        </div>
                    }
                </div>
            </div>

            <div class="bg-gradient-to-br from-indigo-50 to-white border-2 border-dashed border-indigo-200 rounded-2xl p-8 shadow-inner relative overflow-hidden group hover:border-indigo-300 transition-colors">

                <div class="absolute top-0 left-0 w-1.5 h-full bg-indigo-400"></div>

                <h3 class="text-xl font-bold text-indigo-900 mb-6 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-indigo-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Add New Card
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-indigo-600/80 uppercase">Question Type</label>
                        <select class="w-full px-4 py-2.5 bg-white border border-indigo-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700"
                                @bind="NewCard.QuestionType">
                            <option value="">Select type...</option>
                            @foreach (var type in Enum.GetValues<ContentType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-indigo-600/80 uppercase">Answer Type</label>
                        <select class="w-full px-4 py-2.5 bg-white border border-indigo-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700"
                                @bind="NewCard.AnswerType">
                            <option value="">Select type...</option>
                            @foreach (var type in Enum.GetValues<ContentType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-indigo-600/80 uppercase">Question Content</label>
                        <textarea class="w-full px-4 py-3 bg-white border border-indigo-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 placeholder-indigo-200 resize-y min-h-[80px]"
                                  rows="2"
                                  placeholder="Type the question here..."
                                  @bind="NewCard.QuestionContent"></textarea>
                    </div>

                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-indigo-600/80 uppercase">Answer Content</label>
                        <textarea class="w-full px-4 py-3 bg-white border border-indigo-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 placeholder-indigo-200 resize-y min-h-[80px]"
                                  rows="2"
                                  placeholder="Type the answer here..."
                                  @bind="NewCard.AnswerContent"></textarea>
                    </div>

                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-indigo-600/80 uppercase">Description (Optional)</label>
                        <input class="w-full px-4 py-2.5 bg-white border border-indigo-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700 placeholder-indigo-200"
                               placeholder="Extra hints or notes..."
                               @bind="NewCard.Description" />
                    </div>
                </div>

                <div class="flex justify-end mt-6">
                    <button class="px-8 py-3 bg-white text-indigo-600 border border-indigo-200 rounded-xl font-bold hover:bg-indigo-600 hover:text-white hover:border-indigo-600 hover:shadow-lg transition-all duration-200 flex items-center gap-2"
                            @onclick="@HandleAddNewCard">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Add to List
                    </button>
                </div>
            </div>

            <div class="flex justify-end pt-4 pb-12">
                <button class="w-full md:w-auto px-10 py-4 bg-slate-800 text-white rounded-xl text-lg font-bold hover:bg-slate-900 shadow-xl transition-transform hover:-translate-y-1 flex items-center justify-center gap-3"
                        @onclick="@SaveCollection">
                    <span>Save Collection</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                </button>
            </div>

        </div>
    }
</div>


