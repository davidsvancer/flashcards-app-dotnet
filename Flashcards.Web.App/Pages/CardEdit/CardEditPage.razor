@page "/cards/edit/{Id:guid}"
@layout EditLayout
@inherits PageBase
@using Microsoft.AspNetCore.Authorization
@using Flashcards.Common.Models
@using Flashcards.Common.Enums
@attribute [Authorize]

<div class="w-full min-h-screen flex justify-center py-12 px-6 bg-slate-50">
    <div class="w-full max-w-[1100px] flex flex-col gap-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
                    <span class="p-2 bg-indigo-100 rounded-lg text-indigo-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                        </svg>
                    </span>
                    Edit Card
                </h1>
                <p class="text-slate-500 mt-1 ml-14">Modify content and properties of this card.</p>
            </div>
            <button class="px-6 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all flex items-center gap-2" @onclick="@SaveCard">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                Save Changes
            </button>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
            @if (_card == null)
            {
                <div class="flex justify-center p-12">
                    <span class="text-slate-400">Loading card data...</span>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-6">
                        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2 text-indigo-900">
                            <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Question
                        </h2>
                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Type</label>
                            <div class="relative">
                                <select class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700 appearance-none" @bind="_card.QuestionType">
                                    @foreach (var type in Enum.GetValues<ContentType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-2 pointer-events-none text-slate-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Content</label>
                            @if (_card.QuestionType == ContentType.Image)
                            {
                                <div class="space-y-3">
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                                            </svg>
                                        </div>
                                        <input class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 placeholder-slate-400" placeholder="Paste image URL here..." @bind="_card.QuestionContent" @bind:event="oninput" />
                                    </div>
                                    <div class="border-2 border-dashed border-slate-200 rounded-xl p-4 bg-slate-50 flex flex-col items-center justify-center min-h-[200px]">
                                        @if (!string.IsNullOrEmpty(_card.QuestionContent))
                                        {
                                            <img src="@_card.QuestionContent" class="max-h-[250px] w-auto object-contain rounded shadow-sm" alt="Preview" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 italic">Image preview will appear here</span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <textarea class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 placeholder-slate-400 resize-y min-h-[150px]" placeholder="Type your question here..." @bind="_card.QuestionContent"></textarea>
                            }
                        </div>
                    </div>

                    <div class="space-y-6">
                        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-2 text-emerald-900">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Answer
                        </h2>
                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Type</label>
                            <div class="relative">
                                <select class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-700 appearance-none" @bind="_card.AnswerType">
                                    @foreach (var type in Enum.GetValues<ContentType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-2 pointer-events-none text-slate-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Content</label>
                            @if (_card.AnswerType == ContentType.Image)
                            {
                                <div class="space-y-3">
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                                            </svg>
                                        </div>
                                        <input class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 placeholder-slate-400" placeholder="Paste image URL here..." @bind="_card.AnswerContent" @bind:event="oninput" />
                                    </div>
                                    <div class="border-2 border-dashed border-slate-200 rounded-xl p-4 bg-slate-50 flex flex-col items-center justify-center min-h-[200px]">
                                        @if (!string.IsNullOrEmpty(_card.AnswerContent))
                                        {
                                            <img src="@_card.AnswerContent" class="max-h-[250px] w-auto object-contain rounded shadow-sm" alt="Preview" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 italic">Image preview will appear here</span>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <textarea class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 placeholder-slate-400 resize-y min-h-[150px]" placeholder="Type the correct answer here..." @bind="_card.AnswerContent"></textarea>
                            }
                        </div>
                    </div>

                    <div class="md:col-span-2 pt-6 border-t border-slate-100">
                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700 uppercase tracking-wider">Description (Optional)</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                                    </svg>
                                </div>
                                <input class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition text-slate-700" placeholder="Extra notes, hints, or context..." @bind="_card.Description" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex justify-end pt-4 pb-12">
            <button class="w-full md:w-auto px-10 py-4 bg-slate-800 text-white rounded-xl text-lg font-bold hover:bg-slate-900 shadow-xl transition-transform hover:-translate-y-1 flex items-center justify-center gap-3" @onclick="@SaveCard">
                <span>Save Card</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
            </button>
        </div>
    </div>
</div>