@namespace Flashcards.Web.App.Components


<div class="@Class bg-white rounded-2xl border border-slate-200 p-6 flex flex-col shadow-lg relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-indigo-500"></div>

    <EditForm Model="@Model" OnValidSubmit="@HandleSubmit" class="flex flex-col h-full">
        <DataAnnotationsValidator />

        <div class="mb-6 text-center">
            <h3 class="text-xl font-bold text-slate-800">New Collection</h3>
            <p class="text-xs text-slate-400 mt-1">Configure your new flashcard set</p>
        </div>

        <div class="flex-1 space-y-4">
            <div class="space-y-1">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide">Title</label>
                <InputText class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-slate-700"
                           placeholder="e.g., Biology 101"
                           @bind-Value="Model.Title" />
                <ValidationMessage For="@(() => Model.Title)" class="text-xs text-red-500" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide">Start Date</label>
                    <InputDate class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition text-slate-700 text-sm"
                               @bind-Value="Model.AnswerStart"
                               TValue="DateTime?" />
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide">End Date</label>
                    <InputDate class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition text-slate-700 text-sm"
                               @bind-Value="Model.AnswerEnd"
                               TValue="DateTime?" />
                </div>
            </div>

            <div class="text-xs text-red-500">
                <ValidationSummary />
            </div>
        </div>

        <div class="flex gap-3 mt-auto pt-4 border-t border-slate-100">
            <button type="button" class="flex-1 px-4 py-2 text-slate-600 bg-white border border-slate-200 rounded-xl font-semibold hover:bg-slate-50 hover:text-slate-800 transition"
                    @onclick="HandleCancel">
                Cancel
            </button>
            <button type="submit" class="flex-1 px-4 py-2 bg-indigo-600 text-white rounded-xl font-semibold hover:bg-indigo-700 shadow-md shadow-indigo-200 transition">
                Create
            </button>
        </div>

    </EditForm>
</div>




@code {
    [Parameter] public string? Class { get; set; }

    [Parameter, EditorRequired]
    public CardCollectionDetailModel Model { get; set; } = default!;
    
    [Parameter]
    public EventCallback<CardCollectionDetailModel> Submit { get; set; }
    
    [Parameter]
    public EventCallback Cancel { get; set; }
    
    private async Task HandleSubmit()  {
        if(Submit.HasDelegate) {
            await Submit.InvokeAsync(Model);
        }
    }
    
    private async Task HandleCancel() {
        if (Cancel.HasDelegate)
        {
            await Cancel.InvokeAsync();
        }
    }
    
    

}