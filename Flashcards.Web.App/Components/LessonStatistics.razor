@namespace Flashcards.Web.App.Components
<div class="h-full w-full flex items-center justify-center mt-10">

    <div class="aspect-[16/10] w-full max-w-[1000px] bg-white border border-slate-200 rounded-[2rem] p-12 shadow-2xl flex flex-col gap-8 ring-1 ring-black/5">

        <div class="text-center space-y-4">
            <div class="flex justify-center mb-2">
                <span class="bg-indigo-100 text-indigo-600 px-4 py-1 rounded-full text-sm font-bold uppercase tracking-wider">Lesson Completed</span>
            </div>
            <div class="text-6xl font-black text-slate-900 flex justify-center items-center gap-4">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-14 h-14 text-amber-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-5.25a1.125 1.125 0 0 0-1.125 1.125v3.375m9 0H5.625c-.621 0-1.125-.504-1.125-1.125V17.25a3.375 3.375 0 0 1 3.375-3.375h8.25a3.375 3.375 0 0 1 3.375 3.375v.375c0 .621-.504 1.125-1.125 1.125Z" />
                </svg>
                @Lesson.CardCollection.Title
            </div>

            <div class="text-2xl font-medium text-slate-500 max-w-2xl mx-auto">
                Great job! You reviewed <span class="text-indigo-600 font-bold underline decoration-indigo-200 underline-offset-4">@Lesson.Seen</span> out of <span class="text-slate-800 font-bold">@Lesson.CardCollection.Cards.Count</span> cards!
            </div>
        </div>

        <div class="grid grid-cols-2 gap-10 items-center mt-4">

            <div class="bg-slate-50 border border-slate-100 rounded-3xl p-8 shadow-sm ring-1 ring-slate-200/50">
                <div class="text-2xl font-bold text-slate-800 flex items-center gap-3 border-b border-slate-200 pb-4 mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-indigo-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                    </svg>
                    Performance Summary
                </div>

                <div class="space-y-4 text-xl text-slate-600">
                    <div class="flex justify-between items-center bg-white p-3 rounded-xl shadow-sm">
                        <span class="font-semibold text-slate-500">Completed</span>
                        <span class="font-bold text-slate-900">@Lesson.Seen / @Lesson.CardCollection.Cards.Count</span>
                    </div>

                    <div class="flex justify-between items-center p-3">
                    <span class="text-emerald-600 font-bold flex items-center gap-2">
                        <span class="w-2 h-2 bg-emerald-500 rounded-full"></span> Correct
                    </span>
                        <span class="font-bold text-slate-900">@Lesson.Correct</span>
                    </div>

                    <div class="flex justify-between items-center p-3">
                    <span class="text-rose-600 font-bold flex items-center gap-2">
                        <span class="w-2 h-2 bg-rose-500 rounded-full"></span> Wrong
                    </span>
                        <span class="font-bold text-slate-900">@Lesson.Wrong</span>
                    </div>
                </div>
            </div>

            <div class="flex justify-center items-center">
                <div class="relative group">
                    <div class="absolute -inset-4 bg-gradient-to-tr from-indigo-500 to-purple-500 rounded-full opacity-20 group-hover:opacity-30 transition duration-500 blur-xl"></div>
                    <div class="relative w-56 h-56 bg-gradient-to-br from-indigo-50 to-white border border-indigo-100 rounded-full flex items-center justify-center shadow-xl">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-32 h-32 text-indigo-600/80">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                        </svg>
                    </div>
                </div>
            </div>

        </div>

        <div class="flex justify-center gap-6 mt-auto pt-6 border-t border-slate-100 mt-18">

            <button class="flex-1 max-w-[280px] px-8 py-4 bg-indigo-600 text-white rounded-2xl text-xl font-bold hover:bg-indigo-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex justify-center items-center gap-3"
                    @onclick="HandlePlayAgain">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                Play Again
            </button>

            <button class="flex-1 max-w-[280px] px-8 py-4 bg-slate-800 text-white rounded-2xl text-xl font-bold hover:bg-slate-900 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 flex justify-center items-center gap-3"
                    @onclick="HandleTryDifferent">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-slate-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                </svg>
                Different Cards
            </button>

        </div>
    </div>
</div>

@code {
    [Parameter] public LessonDetailModel Lesson { get; set; } = null!;
    [Parameter] public EventCallback OnPlayAgain { get; set; }
    [Parameter] public EventCallback OnTryDifferent { get; set; }

    private void HandlePlayAgain()
    {
        if (OnPlayAgain.HasDelegate)
        {
            OnPlayAgain.InvokeAsync();
        }
    }

    private void HandleTryDifferent()
    {
        if (OnTryDifferent.HasDelegate)
        {
            OnTryDifferent.InvokeAsync();
        }
    }
}