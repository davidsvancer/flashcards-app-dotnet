@namespace Flashcards.Web.App.Components

<div class="border p-4 mb-4 rounded">
    <div class="flex gap-2">
        <input class="flex-1 p-2 border rounded text-sm" @bind="Card.QuestionContent" placeholder="Question" />
        <input class="flex-1 p-2 border rounded text-sm" @bind="Card.AnswerContent" placeholder="Answer" />
        <select class="p-2 border rounded text-sm" @bind="Card.QuestionType">
            @foreach (var t in Enum.GetValues<ContentType>())
            {
                <option value="@t">@t</option>
            }
        </select>
        <select class="p-2 border rounded text-sm" @bind="Card.AnswerType">
            @foreach (var t in Enum.GetValues<ContentType>())
            {
                <option value="@t">@t</option>
            }
        </select>
        <button class="px-3 py-1 text-sm text-red-500 border border-red-500 rounded hover:bg-red-500 hover:text-white" @onclick="Remove">Remove</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CardDetailModel Card { get; set; } = null;

    [Parameter]
    public EventCallback<CardDetailModel> OnRemove { get; set; }

    private async Task Remove()
    {
        if (OnRemove.HasDelegate)
        {
            await OnRemove.InvokeAsync(Card);
        }
    }
}
