@namespace Flashcards.Web.App.Components

<div class="w-full min-h-screen flex flex-col items-center py-10 px-6 bg-slate-50/50">

    <div class="text-center space-y-3 mb-8">
        <h1 class="text-5xl font-extrabold text-slate-800 tracking-tight">@_cardCollection.Title</h1>

        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-full text-slate-500 shadow-sm text-sm font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-indigo-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            <span>Active: @_cardCollection.AnswerStart?.ToShortDateString() — @_cardCollection.AnswerEnd?.ToShortDateString()</span>
        </div>
    </div>

    <div class="w-full max-w-[1000px] perspective-1000"> <div class="aspect-[16/10] w-full relative group cursor-pointer" @onclick="FlipCard">

            <div class="flip-container w-full h-full">
                <div class="flip-card w-full h-full transition-transform duration-700 transform-style-3d @(_isFlipped ? "flipped" : "")">

                    <div class="flip-front absolute inset-0 backface-hidden w-full h-full bg-white border border-slate-200 rounded-[2.5rem] shadow-2xl flex flex-col items-center justify-center p-12 overflow-hidden">

                        <div class="absolute top-6 text-xs font-bold tracking-widest text-slate-300 uppercase">Question</div>

                        <div class="text-4xl font-bold text-slate-800 text-center leading-relaxed w-full h-full flex items-center justify-center">
                            @if (_cardCollection.Cards.Count > 0 && _cardCollection.Cards[_index].QuestionType == ContentType.Image)
                            {
                            <img src="@_cardCollection.Cards[_index].QuestionContent"
                                 alt="@_cardCollection.Cards[_index].Description"
                                 class="max-w-full max-h-full object-contain rounded-xl drop-shadow-md" />
                            }
                            else if (_cardCollection.Cards.Count > 0)
                            {
                            @_cardCollection.Cards[_index].QuestionContent
                            }
                        </div>

                        <div class="absolute bottom-6 flex items-center gap-2 text-slate-400 text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                            Click to flip
                        </div>
                    </div>

                    <div class="flip-back absolute inset-0 backface-hidden w-full h-full bg-slate-50 border border-indigo-100 rounded-[2.5rem] shadow-2xl flex flex-col items-center justify-center p-12 overflow-hidden">

                        <div class="absolute top-6 text-xs font-bold tracking-widest text-indigo-400 uppercase">Answer</div>

                        <div class="text-4xl font-medium text-slate-700 text-center leading-relaxed w-full h-full flex items-center justify-center">
                            @if (_cardCollection.Cards.Count > 0 && _cardCollection.Cards[_index].AnswerType == ContentType.Image)
                            {
                            <img src="@_cardCollection.Cards[_index].AnswerContent"
                                 alt="@_cardCollection.Cards[_index].Description"
                                 class="max-w-full max-h-full object-contain rounded-xl drop-shadow-md" />
                            }
                            else if (_cardCollection.Cards.Count > 0)
                            {
                            @_cardCollection.Cards[_index].AnswerContent
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="mt-10 w-full max-w-[1000px] bg-white border border-slate-200 rounded-2xl p-4 shadow-lg flex flex-col md:flex-row justify-between items-center gap-6">

        <div class="flex items-center gap-4 w-full md:w-auto justify-center">
            <button type="button" class="group flex items-center justify-center w-14 h-14 rounded-xl bg-slate-100 text-slate-600 hover:bg-indigo-600 hover:text-white hover:shadow-md transition-all duration-200"
                    @onclick="HandleClickBack" title="Previous Card">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 group-hover:-translate-x-0.5 transition-transform">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
            </button>

            <div class="px-6 py-3 bg-slate-50 rounded-xl text-lg font-bold text-slate-700 border border-slate-100 min-w-[100px] text-center">
                @(_index + 1) <span class="text-slate-400 font-normal mx-1">/</span> @_cardCollection.Cards.Count
            </div>

            <button type="button" class="group flex items-center justify-center w-14 h-14 rounded-xl bg-slate-100 text-slate-600 hover:bg-indigo-600 hover:text-white hover:shadow-md transition-all duration-200"
                    @onclick="HandleClickNext" title="Next Card">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 group-hover:translate-x-0.5 transition-transform">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </button>
        </div>

        <div class="flex items-center gap-4 w-full md:w-auto justify-center">
            @if (_cardCollection.Cards.Count > 0)
            {
            var currentCard = @_cardCollection.Cards[_index];
            if (!IsAnswered(currentCard.Id))
            {
            <button type="button" class="flex-1 md:flex-none px-8 py-3.5 bg-rose-100 text-rose-700 rounded-xl font-bold hover:bg-rose-600 hover:text-white hover:shadow-lg transition-all duration-200 flex items-center gap-2"
                    @onclick="() => HandleMarkWrongAsync(currentCard.Id)">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                I don't know
            </button>

            <button type="button" class="flex-1 md:flex-none px-8 py-3.5 bg-emerald-100 text-emerald-700 rounded-xl font-bold hover:bg-emerald-600 hover:text-white hover:shadow-lg transition-all duration-200 flex items-center gap-2"
                    @onclick="() => HandleMarkCorrectAsync(currentCard.Id)">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                I know it
            </button>
            }
            else
            {
            <div class="px-6 py-3 rounded-xl font-bold text-white flex items-center gap-3 shadow-sm select-none @GetAnsweredBadgeClass(currentCard.Id)">
                @if(GetAnswerState(currentCard.Id).ToString().ToLower().Contains("correct")) {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                } else {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                }
                <span>Answered: @GetAnswerState(currentCard.Id)</span>
            </div>
            }
            }
            else
            {
            <div class="text-slate-400 italic">No cards in this collection</div>
            }
        </div>
    </div>
</div>

@code {
    private bool _isFlipped = false;
    
    [Parameter, EditorRequired]
    public CardCollectionDetailModel _cardCollection { get; set; } = default!;

    [Parameter]
    public int _index { get; set; }

    [Parameter]
    public EventCallback OnFlip { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public EventCallback<Guid> OnMarkCorrect { get; set; }

    [Parameter]
    public EventCallback<Guid> OnMarkWrong { get; set; }

    [Parameter, EditorRequired]
    public Func<Guid, bool> IsAnswered { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<Guid, string> GetAnswerState { get; set; } = default!;

    private string GetAnsweredBadgeClass(Guid cardId)
    {
        var state = GetAnswerState(cardId)?.ToLowerInvariant() ?? string.Empty;
        return state.Contains("correct") ? "bg-green-500" : state.Contains("wrong") ? "bg-red-500" : "bg-gray-700";
    }

    private void FlipCard()
    {
        _isFlipped = !_isFlipped;
        if (OnFlip.HasDelegate)
        {
            _ = OnFlip.InvokeAsync(null);
        }
    }

    private async Task HandleClickNext()
    {
        _isFlipped = false;
        if (OnNext.HasDelegate)
            await OnNext.InvokeAsync(null);
    }

    private async Task HandleClickBack()
    {
        _isFlipped = false;
        if (OnBack.HasDelegate)
            await OnBack.InvokeAsync(null);
    }

    private async Task HandleMarkCorrectAsync(Guid cardId)
    {
        if (OnMarkCorrect.HasDelegate)
            await OnMarkCorrect.InvokeAsync(cardId);
    }

    private async Task HandleMarkWrongAsync(Guid cardId)
    {
        if (OnMarkWrong.HasDelegate)
            await OnMarkWrong.InvokeAsync(cardId);
    }
}