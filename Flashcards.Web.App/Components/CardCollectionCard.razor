@namespace Flashcards.Web.App.Components

<div class="group relative bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 p-6 flex flex-col justify-between overflow-hidden @Class @(IsActive ? "bg-white" : "bg-slate-50") @(OnClick.HasDelegate ? "cursor-pointer hover:ring-2 hover:ring-indigo-500/50" : "")"
     @onclick="HandleCardClick">

    <div class="absolute top-0 left-0 w-full h-1.5 @(IsActive ? "bg-gradient-to-r from-blue-500 to-indigo-500" : "bg-slate-300")"></div>

    <div class="space-y-4 @(IsActive ? "" : "opacity-60 grayscale")">
        <div class="text-center pb-2 border-b border-slate-100">
            <h3 class="text-xl font-bold text-slate-800 truncate" title="@Collection.Title">@Collection.Title</h3>
            <div class="mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(IsActive ? "bg-green-100 text-green-800" : "bg-slate-200 text-slate-600")">
                @(IsActive ? "Active" : "Closed")
            </div>
        </div>

        <div class="space-y-3 pt-2">
            <div class="flex items-center gap-3 text-slate-600">
                <div class="p-2 bg-slate-100 rounded-lg text-slate-500">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-xs font-bold uppercase text-slate-400 tracking-wider">Start</span>
                    <span class="font-medium text-sm">@Collection.AnswerStart?.ToString("d. MMM yyyy")</span>
                </div>
            </div>

            <div class="flex items-center gap-3 text-slate-600">
                <div class="p-2 bg-slate-100 rounded-lg text-slate-500">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                    </svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-xs font-bold uppercase text-slate-400 tracking-wider">End</span>
                    <span class="font-medium text-sm">@Collection.AnswerEnd?.ToString("d. MMM yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="pt-6 mt-auto">
        @if (IsOwner)
        {
        <div class="flex justify-between items-center gap-2">
            <button class="flex-1 px-4 py-2.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition shadow-sm
                               @(IsActive ? "bg-indigo-600 text-white hover:bg-indigo-700 hover:shadow-md" : "bg-slate-100 text-slate-400 cursor-not-allowed")"
                    @onclick="HandlePlayClicked"
                    @onclick:stopPropagation="true"
                    disabled="@(!IsActive)">
                <svg xmlns="http://www.w3.org/2000/svg" fill="viewBox" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 fill-current">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                </svg>
                Play
            </button>

            <div class="flex gap-2">
                <button class="p-2.5 text-slate-500 border border-slate-200 rounded-xl hover:bg-white hover:border-amber-400 hover:text-amber-500 hover:shadow-sm transition"
                        title="Edit" @onclick="EditClicked" @onclick:stopPropagation="true">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                    </svg>
                </button>
                <button class="p-2.5 text-slate-500 border border-slate-200 rounded-xl hover:bg-white hover:border-red-400 hover:text-red-500 hover:shadow-sm transition"
                        title="Delete" @onclick="DeleteClicked" @onclick:stopPropagation="true">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                </button>
            </div>
        </div>
        }
        else
        {
        <div class="flex justify-center items-center">
            <button class="w-full py-3 rounded-xl font-bold text-lg flex items-center justify-center gap-2 transition shadow-sm
                               @(IsActive ? "bg-indigo-600 text-white hover:bg-indigo-700 hover:shadow-md" : "bg-slate-100 text-slate-400 cursor-not-allowed")"
                    @onclick="HandlePlayClicked"
                    @onclick:stopPropagation="true"
                    disabled="@(!IsActive)">
                <svg xmlns="http://www.w3.org/2000/svg" fill="viewBox" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 fill-current">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                </svg>
                Play
            </button>
        </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<CardCollectionListModel> OnClick { get; set; }
    [Parameter, EditorRequired] public CardCollectionListModel Collection { get; set; } = null!;
    [Parameter] public EventCallback<CardCollectionListModel> OnEdit { get; set; }
    [Parameter] public EventCallback<CardCollectionListModel> OnDelete { get; set; }
    [Parameter] public EventCallback<CardCollectionListModel> OnPlay { get; set; }
    [Parameter] public bool IsOwner { get; set; }
    [Parameter] public bool IsActive { get; set; } = true;

    private async Task EditClicked()
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Collection);
        }
    }

    private async Task DeleteClicked()
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Collection);
        }
    }
    
    private async Task HandlePlayClicked()
    {
        if (OnPlay.HasDelegate && IsActive)
        {
            await OnPlay.InvokeAsync(Collection);
        }
    }
    
    private async Task HandleCardClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Collection);
        }
    }
}